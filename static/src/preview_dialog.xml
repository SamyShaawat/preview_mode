<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="preview_mode.Dialog" owl="1">
        <Dialog size="'lg'" title="props.title" contentClass="'o_preview_mode_dialog'">
            <div class="alert alert-warning mb-3" role="status">This is a preview. Nothing from this click has been saved yet.</div>
            <p class="o_preview_estimate text-muted small mb-3">This is an estimate. Numbers shown as (new), random values, the time, and changes by other users can differ when you confirm.</p>
            <p t-if="showSummary" class="o_preview_summary" t-out="props.summary"/>
            <div t-foreach="props.warnings" t-as="warning" t-key="warning_index"
                 t-att-class="warning.blocking ? 'alert alert-danger' : 'text-muted'">
                <t t-out="warning.text"/>
            </div>
            <p t-if="props.incomplete" class="text-muted">Some effects could not be previewed and may still happen when you confirm.</p>
            <table t-if="props.changes.length" class="table table-sm o_preview_table caption-top">
                <caption class="fw-bold text-start">What will happen</caption>
                <thead>
                    <tr><th>What</th><th>Where</th></tr>
                </thead>
                <tbody>
                    <tr t-foreach="props.changes" t-as="row" t-key="row_index">
                        <td class="o_preview_what">
                            <div>
                                <span t-if="row.kind === 'new'" class="fw-bold d-inline-block me-2">New</span>
                                <span t-elif="row.kind === 'changed'" class="fw-bold d-inline-block me-2">Changed</span>
                                <span t-elif="row.kind === 'deleted'" class="fw-bold d-inline-block me-2">Deleted</span>
                                <t t-out="row.what"/>
                            </div>
                            <div t-foreach="row.fields" t-as="field" t-key="field_index" class="o_preview_field">
                                <span class="text-muted" t-out="field.label"/>:
                                <s t-if="field.old" class="text-muted" t-out="field.old"/>
                                <span t-if="field.old" class="o_preview_arrow d-inline-block"> → </span>
                                <span class="o_preview_value"><t t-out="field.new or '(empty)'"/></span>
                            </div>
                        </td>
                        <td class="o_preview_where" t-out="row.where"/>
                    </tr>
                </tbody>
            </table>
            <t t-foreach="props.journal" t-as="move" t-key="move_index">
                <table class="table table-sm o_preview_table o_preview_journal caption-top">
                    <caption class="fw-bold text-start">Journal entry <t t-out="move.move"/></caption>
                    <thead>
                        <tr><th>Account</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="move.lines" t-as="line" t-key="line_index">
                            <td t-out="line.account"/>
                            <td class="text-end text-nowrap"><t t-if="line.debit" t-out="line.debit.toFixed(2)"/></td>
                            <td class="text-end text-nowrap"><t t-if="line.credit" t-out="line.credit.toFixed(2)"/></td>
                        </tr>
                    </tbody>
                </table>
            </t>
            <table t-foreach="props.sections" t-as="section" t-key="section_index" class="table table-sm o_preview_table o_preview_section caption-top">
                <caption class="fw-bold text-start" t-out="section.title"/>
                <thead t-if="section.columns.length">
                    <tr><th t-foreach="section.columns" t-as="column" t-key="column_index" t-out="column"/></tr>
                </thead>
                <tbody>
                    <tr t-foreach="section.rows" t-as="row" t-key="row_index">
                        <td t-foreach="row" t-as="cell" t-key="cell_index" t-out="cell"/>
                    </tr>
                </tbody>
            </table>
            <table t-if="props.emails.length" class="table table-sm o_preview_table caption-top">
                <caption class="fw-bold text-start">Emails (not sent during the preview)</caption>
                <tbody>
                    <tr t-foreach="props.emails" t-as="mail" t-key="mail_index">
                        <td t-out="mail.subject"/><td t-out="mail.to"/>
                    </tr>
                </tbody>
            </table>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm" t-out="props.confirmLabel"/>
                <button class="btn btn-secondary" t-on-click="back">Go back</button>
                <button class="btn btn-link" t-on-click="copy">Copy</button>
            </t>
        </Dialog>
    </t>
</templates>
